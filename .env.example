# ============================================================================
# .env  —  environment variables for this project
# ============================================================================
# WHAT THIS FILE IS
#   A plain-text list of KEY=VALUE pairs. Node reads it and puts each pair on
#   `process.env`, so code can read configuration without hard-coding it.
#   Node docs (built-in .env support, no library needed):
#     https://nodejs.org/api/process.html#processloadenvfilepath
#     https://nodejs.org/api/cli.html#--env-fileconfig
#
# WHAT THIS FILE IS *NOT*
#   .env does not hide anything by itself. `private/` is kept off GitHub by
#   the `private/` rule in .gitignore (see .gitignore line 15).
#   .env only stores the folder NAME so scripts don't hard-code it, and .env
#   itself is gitignored so anything secret you add later stays local.
#
# SYNTAX RULES
#   KEY=value      no spaces around `=`
#   # comment      a line starting with # is ignored
#   KEY="a value"  quotes are only needed when the value has spaces or #
# ============================================================================

# Folder holding your own drafts, notes, and attempts. Git ignores it entirely.
# Read by scripts/private.ts (see PRIVATE_DIR there).
PRIVATE_DIR=private

# Folder the graders and the test suite read. tests/*.test.ts import from here.
SRC_DIR=src
